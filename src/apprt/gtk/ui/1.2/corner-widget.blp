using Gtk 4.0;
using Adw 1;

// Corner widget (fork addition): date, clock, weather and the song playing
// in the room. Data comes from the ghostty-widget service; see
// contrib/corner-widget/README.md.
template $GhosttyCornerWidget: Adw.Bin {
  halign: end;
  valign: start;
  can-focus: false;
  can-target: false;
  focusable: false;

  Box {
    styles [
      "corner-widget",
    ]

    orientation: vertical;
    halign: end;

    Label date_label {
      styles [
        "corner-date",
      ]

      xalign: 1.0;
    }

    Label time_label {
      styles [
        "corner-time",
      ]

      xalign: 1.0;
    }

    Label weather_label {
      styles [
        "corner-weather",
      ]

      use-markup: true;
      xalign: 1.0;
    }

    Box song_box {
      styles [
        "corner-song",
      ]

      orientation: horizontal;
      spacing: 12;
      visible: false;
      halign: end;

      Box {
        orientation: vertical;
        valign: center;

        Label artist_label {
          styles [
            "corner-artist",
          ]

          ellipsize: end;
          max-width-chars: 28;
          xalign: 1.0;
        }

        Label song_label {
          styles [
            "corner-song-title",
          ]

          ellipsize: end;
          max-width-chars: 28;
          xalign: 1.0;
        }
      }

      // Album cover as a record, with song progress as a ring around it.
      DrawingArea vinyl {
        content-width: 58;
        content-height: 58;
        valign: center;
      }
    }
  }
}
