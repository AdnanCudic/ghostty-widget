using Gtk 4.0;
using Adw 1;

// Corner widget (fork addition): date, clock, weather and the song playing
// in the room. Data comes from the ghostty-widget service; see
// contrib/corner-widget/README.md.
//
// Only the record and the open lyrics sheet take input. Everything else lets
// clicks through to the terminal: labels have can-target off, and the boxes
// are $GhosttyPassBox, a Box that never claims its own empty space.
template $GhosttyCornerWidget: Adw.Bin {
  halign: end;
  valign: start;
  can-focus: false;
  focusable: false;

  $GhosttyPassBox {
    styles [
      "corner-widget",
    ]

    orientation: vertical;
    halign: end;

    Label date_label {
      styles [
        "corner-date",
      ]

      can-target: false;
      xalign: 1.0;
    }

    Label time_label {
      styles [
        "corner-time",
      ]

      can-target: false;
      xalign: 1.0;
    }

    Label weather_label {
      styles [
        "corner-weather",
      ]

      can-target: false;
      use-markup: true;
      xalign: 1.0;
    }

    $GhosttyPassBox song_box {
      styles [
        "corner-song",
      ]

      orientation: horizontal;
      spacing: 12;
      visible: false;
      halign: end;

      $GhosttyPassBox {
        orientation: vertical;
        valign: center;

        Label artist_label {
          styles [
            "corner-artist",
          ]

          can-target: false;
          ellipsize: end;
          max-width-chars: 28;
          xalign: 1.0;
        }

        Label song_label {
          styles [
            "corner-song-title",
          ]

          can-target: false;
          ellipsize: end;
          max-width-chars: 28;
          xalign: 1.0;
        }
      }

      // Album cover as a record, with song progress as a ring around it.
      // Click it to show or hide the lyrics.
      DrawingArea vinyl {
        content-width: 58;
        content-height: 58;
        valign: center;

        GestureClick {
          released => $vinyl_clicked();
        }
      }
    }

    // Lyrics sheet, hidden until the record is clicked. Scrollable; when
    // the lyrics are timed it follows the song, and snaps back to the
    // current line a few seconds after you scroll away.
    Revealer lyrics_revealer {
      transition-type: slide_down;
      transition-duration: 250;
      reveal-child: false;
      halign: end;

      ScrolledWindow lyrics_scroll {
        styles [
          "corner-lyrics",
        ]

        hscrollbar-policy: never;
        width-request: 260;
        height-request: 190;

        EventControllerScroll {
          flags: vertical;
          propagation-phase: capture;
          scroll => $lyrics_scrolled();
        }

        Box lyrics_box {
          orientation: vertical;
        }
      }
    }
  }
}
