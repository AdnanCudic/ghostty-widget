[Unit]
Description=Data collector for the Ghostty corner widget (weather, music, lyrics)
After=network-online.target pipewire.service

[Service]
# Your city and microphone; see the top of widgetd.py.
EnvironmentFile=-%h/.config/ghostty-widget/env
ExecStart=/usr/bin/python3 -I %h/.local/share/ghostty-widget/widgetd.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
