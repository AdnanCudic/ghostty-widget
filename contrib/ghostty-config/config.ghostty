# %LOCALAPPDATA%\ghostty\config.ghostty — the setup this fork is built
# around, for Windows. Copy it there (install.ps1 in contrib/corner-widget
# offers to). See contrib/corner-widget/README.md.

# --- splits ---
keybind = ctrl+shift+minus=new_split:down
keybind = ctrl+shift+plus=new_split:right
keybind = ctrl+shift+equal=new_split:right

# --- tabs ---
keybind = ctrl+shift+t=new_tab

# --- close focused split (closes tab if it's the last one) ---
keybind = ctrl+shift+x=close_surface

# --- navigate splits ---
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down

# --- tab navigation ---
keybind = ctrl+shift+left_bracket=previous_tab
keybind = ctrl+shift+right_bracket=next_tab

# --- quake-style drop-down terminal ---
# `backquote` is the physical key left of 1 on any keyboard layout (the
# ¸ key on Bosnian/Croatian), with no modifier. While Ghostty runs, that
# key no longer types in other programs.
keybind = global:backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 40%
quick-terminal-autohide = true

# --- shaders (applied in order) ---
# Optional: a cursor trail shader of your choice (not included here):
# custom-shader = ~/ghostty-shaders/cursor_trail.glsl
custom-shader-animation = always

theme = Adwaita Dark
background = #000000

# --- sleek window: no title bar or buttons; tabs only with 2+ tabs ---
# (borderless but still resizable from the edges; remove the first line
# to get the normal Windows title bar back)
window-decoration = none
window-show-tab-bar = auto
window-padding-x = 10
window-padding-y = 4
window-theme = ghostty

# SSH tabs turn red by themselves on Windows; the Linux tabs.css and the
# gtk-* options have no Windows equivalent and are left out.

# Glyph fog shader, managed by the ghostty-widget service
# (WIDGET_FOG / WIDGET_RIPPLE in %LOCALAPPDATA%\ghostty-widget\env).
# Relative to this file: %LOCALAPPDATA%\ghostty-widget\shaders.conf
config-file = ?../ghostty-widget/shaders.conf
